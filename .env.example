# Copy to `.env` for local dev. Production: set these in Vercel (and Xcode/Capacitor if needed).

# Supabase project URL (public).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Canonical HTTPS origin of the deployed web app (no trailing slash).
# Used for password reset emails (`resetPasswordForEmail` redirectTo).
# MUST match Supabase Auth → URL Configuration → Redirect URLs, e.g.:
#   https://www.yourdomain.com/reset-password
# In native builds, window.location is not a reliable https origin — set this for release builds.
VITE_PUBLIC_SITE_URL=https://www.armpal.net

# Official ArmPal coaching account (post-request "Connect on ArmPal" flow).
# Prefer UUID; handle is used as fallback lookup in profiles.
# VITE_OFFICIAL_COACHING_USER_ID=your-supabase-auth-user-uuid
# VITE_OFFICIAL_COACHING_HANDLE=armpalcoaching

# Optional: serverless `api/send-reset-email.js` (if you use it)
# PUBLIC_SITE_URL=https://www.armpal.net
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
